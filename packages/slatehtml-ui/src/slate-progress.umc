--- html ---
<horizontalbox class="slate-progress-linear" gap="0" valign="center" width="100%">
  <border class="slate-progress-track" fill height="100%">
    <border class="slate-progress-bar" height="100%"></border>
  </border>
</horizontalbox>
<canvaspanel class="slate-progress-circular" width="40" height="40" hidden>
  <svg class="slate-progress-svg" viewBox="0 0 40 40" width="40" height="40">
    <circle class="slate-progress-circle-track" cx="20" cy="20" r="16"></circle>
    <circle class="slate-progress-circle-bar" cx="20" cy="20" r="16"></circle>
  </svg>
</canvaspanel>

--- style ---
self {
  display: inline-flex; /* umc-layout-ok */
  align-items: center; /* umc-layout-ok */
  color: inherit;
  font: inherit;
  vertical-align: middle;
  max-width: 100%; /* umc-layout-ok */
}

self[variant="linear"],
self:not([variant]) {
  width: 100%; /* umc-layout-ok */
  min-width: 80px; /* umc-layout-ok */
}

.slate-progress-linear {
  width: 100%; /* umc-layout-ok */
  height: var(--slate-progress-thickness, 6px); /* umc-layout-ok */
}

.slate-progress-track {
  --widget-padding: 0;
  --widget-radius: 999px;
  --widget-background: color-mix(in srgb, currentColor 14%, transparent);
  --widget-border: none;
  overflow: hidden;
  position: relative; /* umc-layout-ok */
}

.slate-progress-bar {
  --widget-padding: 0;
  --widget-radius: 999px;
  --widget-background: var(--accent, currentColor);
  --widget-border: none;
  width: calc(var(--slate-progress-value, 0) * 1%); /* umc-layout-ok */
  max-width: 100%; /* umc-layout-ok */
  transition: width 160ms ease;
}

self[indeterminate] .slate-progress-bar {
  width: 35%; /* umc-layout-ok */
  animation: slate-progress-indeterminate 1.1s ease-in-out infinite;
}

@keyframes slate-progress-indeterminate {
  0% { transform: translateX(-120%); }
  100% { transform: translateX(320%); }
}

.slate-progress-circular {
  width: var(--slate-progress-size, 40px); /* umc-layout-ok */
  height: var(--slate-progress-size, 40px); /* umc-layout-ok */
  flex: 0 0 auto; /* umc-layout-ok */
}

.slate-progress-circular[hidden],
.slate-progress-linear[hidden] {
  display: none !important;
}

.slate-progress-svg {
  display: block; /* umc-layout-ok */
  width: 100%; /* umc-layout-ok */
  height: 100%; /* umc-layout-ok */
  transform: rotate(-90deg);
}

.slate-progress-circle-track,
.slate-progress-circle-bar {
  fill: none;
  stroke-width: var(--slate-progress-stroke, 3.5);
}

.slate-progress-circle-track {
  stroke: color-mix(in srgb, currentColor 14%, transparent);
}

.slate-progress-circle-bar {
  stroke: var(--accent, currentColor);
  stroke-linecap: round;
  stroke-dasharray: var(--slate-progress-dash, 100.53);
  stroke-dashoffset: var(--slate-progress-offset, 0);
  transition: stroke-dashoffset 160ms ease;
}

self[indeterminate][variant="circular"] .slate-progress-svg {
  animation: slate-progress-spin 1.2s linear infinite;
}

self[indeterminate][variant="circular"] .slate-progress-circle-bar {
  stroke-dashoffset: 75;
}

@keyframes slate-progress-spin {
  100% { transform: rotate(270deg); }
}

--- script ---
/**
 * Linear / circular progress.
 *
 *   <slate-progress value="62"></slate-progress>
 *   <slate-progress variant="circular" value="40" size="48"></slate-progress>
 *   <slate-progress indeterminate></slate-progress>
 *
 * Attrs: variant (linear|circular), value/percent (0–100), indeterminate,
 *        size (circular), thickness
 */

function clampPercent(raw) {
  const n = Number.parseFloat(String(raw ?? "").trim());
  if (!Number.isFinite(n)) return 0;
  return Math.max(0, Math.min(100, n));
}

function parseSize(raw, fallback) {
  const n = Number.parseFloat(String(raw ?? "").trim());
  return Number.isFinite(n) && n > 0 ? n : fallback;
}

export default defineUmc({
  tag: "slate-progress",
  attrs: {
    variant: "linear",
    value: "0",
    percent: "",
    indeterminate: "",
    size: "40",
    thickness: "",
  },

  SynchronizeProperties(el, { attr }) {
    const variant =
      attr("variant", "linear") === "circular" ? "circular" : "linear";
    el.setAttribute("variant", variant);

    const indeterminate = el.hasAttribute("indeterminate");
    const value = clampPercent(
      attr("percent", "") !== "" ? attr("percent", "0") : attr("value", "0")
    );

    const linear = el.querySelector(".slate-progress-linear");
    const circular = el.querySelector(".slate-progress-circular");
    linear?.toggleAttribute("hidden", variant !== "linear");
    circular?.toggleAttribute("hidden", variant !== "circular");

    el.style.setProperty("--slate-progress-value", String(value));
    el.setAttribute("aria-valuenow", indeterminate ? "" : String(value));
    el.setAttribute("role", "progressbar");
    el.setAttribute("aria-valuemin", "0");
    el.setAttribute("aria-valuemax", "100");
    if (indeterminate) el.removeAttribute("aria-valuenow");

    if (variant === "linear") {
      const thickness = parseSize(attr("thickness", ""), 6);
      el.style.setProperty("--slate-progress-thickness", `${thickness}px`);
    } else {
      const size = parseSize(attr("size", "40"), 40);
      const thickness = parseSize(attr("thickness", ""), Math.max(2.5, size * 0.09));
      const r = 16;
      const c = 2 * Math.PI * r;
      const offset = c - (value / 100) * c;
      el.style.setProperty("--slate-progress-size", `${size}px`);
      el.style.setProperty("--slate-progress-stroke", String(thickness));
      el.style.setProperty("--slate-progress-dash", String(c));
      el.style.setProperty(
        "--slate-progress-offset",
        indeterminate ? "75" : String(offset)
      );
      circular?.setAttribute("width", String(size));
      circular?.setAttribute("height", String(size));
      const svg = el.querySelector(".slate-progress-svg");
      svg?.setAttribute("width", String(size));
      svg?.setAttribute("height", String(size));
    }
  },
});

--- preview ---
<verticalbox gap="14" padding="16" width="260">
  <slate-progress value="62"></slate-progress>
  <horizontalbox gap="12" valign="center">
    <slate-progress variant="circular" value="40" size="40"></slate-progress>
    <slate-progress variant="circular" indeterminate size="40"></slate-progress>
  </horizontalbox>
</verticalbox>
