@parent widgetswitcher

--- html ---
<horizontalbox class="slate-tabs-list" gap="0" valign="end" width="100%"></horizontalbox>

--- style ---
/* Host *is* the widgetswitcher; override contents so the strip + pages stack. */
self {
  display: flex; /* umc-layout-ok */
  flex-direction: column; /* umc-layout-ok */
  align-items: stretch; /* umc-layout-ok */
  color: inherit;
  font: inherit;
  min-width: 0; /* umc-layout-ok */
  min-height: 0; /* umc-layout-ok */
}

self > .slate-tabs-list {
  border-bottom: 1px solid color-mix(in srgb, currentColor 22%, transparent);
  flex: 0 0 auto; /* umc-layout-ok */
  width: 100%; /* umc-layout-ok */
}

self > [page] {
  flex: 1 1 auto; /* umc-layout-ok */
  min-height: 0; /* umc-layout-ok */
}

self .slate-tabs-tab {
  cursor: pointer;
  user-select: none;
  -webkit-user-select: none;
  opacity: 0.62;
  border-bottom: 2px solid transparent;
  margin-bottom: -1px; /* umc-layout-ok, sit on the list rule */
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.02em;
}

self .slate-tabs-tab:hover {
  opacity: 0.9;
}

self .slate-tabs-tab[aria-selected="true"] {
  opacity: 1;
  border-bottom-color: currentColor;
}

self:focus-visible .slate-tabs-tab[aria-selected="true"],
self .slate-tabs-tab:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 2px;
}

--- script ---
import { create } from "slatehtml/umc";
import { enhance } from "slatehtml/widget.js";
import { parseOptions, selectableOptions } from "./input/parse-options.js";

/**
 * Tab strip on a widgetswitcher (@parent). Light children are the pages.
 *
 *   <slate-tabs active="email" height="160">
 *     <border page="basic" label="Basic" kind="panel" padding="12">…</border>
 *     <border page="email" label="Email" kind="panel" padding="12">…</border>
 *   </slate-tabs>
 *
 * Optional `tabs="basic|Basic, email|Email"` overrides labels. Each page needs
 * `page="…"`. Selection is the host `active` attr (same as widgetswitcher).
 *
 * Events: selectionchanged { value, label, index }
 */

function pageChildren(el) {
  return [...el.children].filter((child) => {
    if (child.classList?.contains("slate-tabs-list")) return false;
    return Boolean((child.getAttribute("page") || "").trim());
  });
}

function pagesFromHost(el) {
  return pageChildren(el).map((child) => {
    const value = (child.getAttribute("page") || "").trim();
    const label = (child.getAttribute("label") || value).trim() || value;
    return { type: "option", value, label, avatar: "" };
  });
}

function resolveTabs(el, attr) {
  const fromAttr = selectableOptions(parseOptions(attr("tabs", "")));
  if (fromAttr.length) return fromAttr;
  return pagesFromHost(el);
}

function tabRow(option, selected) {
  const on = option.value === selected;
  return {
    tag: "horizontalbox",
    class: "slate-tabs-tab",
    role: "tab",
    id: `slate-tab-${option.value}`,
    "aria-selected": on ? "true" : "false",
    "data-value": option.value,
    tabindex: on ? "0" : "-1",
    padding: "8 12",
    valign: "center",
    children: [{ tag: "textblock", text: option.label }],
  };
}

function applyActive(el, selected) {
  if (!selected) return;
  if ((el.getAttribute("active") || "") !== selected) {
    el.setAttribute("active", selected);
  }
  try {
    enhance(el);
  } catch {
    /* ignore */
  }
}

function select(el, api, value) {
  const tabs = resolveTabs(el, api.attr);
  const index = tabs.findIndex((t) => t.value === value);
  if (index < 0) return;
  if (value === api.attr("active", "")) {
    applyActive(el, value);
    return;
  }
  applyActive(el, value);
  api.emit("selectionchanged", {
    value,
    label: tabs[index].label,
    index,
  });
}

export default defineUmc({
  tag: "slate-tabs",
  attrs: {
    tabs: "",
    active: "",
  },

  Construct(el, api) {
    if (!el.hasAttribute("tabindex")) el.setAttribute("tabindex", "0");
    el.setAttribute("role", "navigation");

    if (el._bound) return;
    el._bound = true;

    el.addEventListener("click", (e) => {
      const tab = e.target?.closest?.(".slate-tabs-tab");
      if (!tab || !el.contains(tab)) return;
      const value = tab.getAttribute("data-value");
      if (value != null) select(el, api, value);
    });

    el.addEventListener("keydown", (e) => {
      const tabs = resolveTabs(el, api.attr);
      if (!tabs.length) return;
      const current = tabs.findIndex((t) => t.value === api.attr("active", ""));
      if (e.key === "ArrowRight" || e.key === "ArrowDown") {
        e.preventDefault();
        const next = current < 0 ? 0 : Math.min(tabs.length - 1, current + 1);
        select(el, api, tabs[next].value);
      } else if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
        e.preventDefault();
        const next = current < 0 ? tabs.length - 1 : Math.max(0, current - 1);
        select(el, api, tabs[next].value);
      } else if (e.key === "Home") {
        e.preventDefault();
        select(el, api, tabs[0].value);
      } else if (e.key === "End") {
        e.preventDefault();
        select(el, api, tabs[tabs.length - 1].value);
      }
    });
  },

  SynchronizeProperties(el, { attr }) {
    const tabs = resolveTabs(el, attr);
    let selected = attr("active", "");
    if (!selected && tabs.length) {
      selected = tabs[0].value;
      if (attr("active", "") !== selected) el.setAttribute("active", selected);
    }

    const list = el.querySelector(":scope > .slate-tabs-list");
    if (list) {
      list.setAttribute("role", "tablist");
      // Keep the strip first among host children.
      if (el.firstElementChild !== list) el.insertBefore(list, el.firstChild);
      const key = tabs.map((t) => `${t.value}\u0000${t.label}`).join("\u0001");
      if (el._tabsKey !== key) {
        el._tabsKey = key;
        list.replaceChildren(
          ...tabs.map((option) => create(tabRow(option, selected))).filter(Boolean)
        );
      } else {
        for (const tab of list.querySelectorAll(".slate-tabs-tab")) {
          const on = tab.getAttribute("data-value") === selected;
          tab.setAttribute("aria-selected", on ? "true" : "false");
          tab.setAttribute("tabindex", on ? "0" : "-1");
        }
      }
    }

    if (selected) applyActive(el, selected);
  },
});

--- preview ---
<canvaspanel width="380" height="220" kind="stage">
  <slate-tabs active="email" anchors="fill" top="12" left="12" right="12" bottom="12">
    <border page="basic" label="Basic" kind="panel" padding="12">
      <slate-text text="Basic panel"></slate-text>
    </border>
    <border page="email" label="Email" kind="panel" padding="12">
      <slate-text text="Email panel"></slate-text>
    </border>
    <border page="bio" label="Bio" kind="panel" padding="12">
      <slate-text text="Bio panel"></slate-text>
    </border>
  </slate-tabs>
</canvaspanel>
