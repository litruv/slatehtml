--- html ---
<horizontalbox class="slate-pagination-row" gap="4" valign="center"></horizontalbox>

--- style ---
self {
  display: inline-flex; /* umc-layout-ok, painted control host */
  color: inherit;
  font: inherit;
  flex: 0 0 auto; /* umc-layout-ok */
}

self .slate-pagination-row {
  flex: 0 0 auto; /* umc-layout-ok */
}

self .slate-pagination-item {
  display: inline-flex; /* umc-layout-ok */
  align-items: center; /* umc-layout-ok */
  justify-content: center; /* umc-layout-ok */
  box-sizing: border-box;
  min-width: 32px; /* umc-layout-ok */
  height: 32px; /* umc-layout-ok */
  padding: 0 8px; /* umc-layout-ok */
  border: 1px solid color-mix(in srgb, currentColor 22%, transparent);
  border-radius: var(--widget-radius, 4px);
  background: transparent;
  color: inherit;
  font: inherit;
  font-size: 12px;
  font-weight: 600;
  line-height: 1;
  cursor: pointer;
  user-select: none;
  -webkit-user-select: none;
  flex: 0 0 auto; /* umc-layout-ok */
}

self .slate-pagination-item:hover:not([disabled]):not([aria-current="page"]) {
  background: color-mix(in srgb, currentColor 10%, transparent);
}

self .slate-pagination-item[aria-current="page"] {
  background: var(--accent, currentColor);
  border-color: var(--accent, currentColor);
  color: var(--hud-ink, #fff);
  cursor: default;
}

self .slate-pagination-item[disabled] {
  opacity: 0.4;
  cursor: default;
  pointer-events: none;
}

self .slate-pagination-ellipsis {
  min-width: 28px; /* umc-layout-ok */
  border-color: transparent;
  cursor: default;
  pointer-events: none;
  opacity: 0.55;
  font-weight: 500;
}

self:focus-visible .slate-pagination-item[aria-current="page"],
self .slate-pagination-item:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 2px;
}

self[disabled] {
  opacity: 0.5;
  pointer-events: none;
}

--- script ---
import { create } from "slatehtml/umc";

/**
 * Page number strip with prev/next (and optional first/last).
 *
 *   <slate-pagination count="10" page="3"></slate-pagination>
 *   <slate-pagination count="24" page="1" show-first show-last sibling-count="1"></slate-pagination>
 *
 * Attrs: page (1-based), count (total pages), sibling-count, boundary-count,
 *   show-first, show-last, disabled
 * Events: pagechanged { page, previous }
 */

function attrOn(el, name) {
  if (!el.hasAttribute(name)) return false;
  const v = String(el.getAttribute(name) ?? "")
    .trim()
    .toLowerCase();
  return v === "" || v === "true" || v === "1" || v === "on";
}

function intAttr(el, name, fallback) {
  const n = Number.parseInt(String(el.getAttribute(name) ?? ""), 10);
  return Number.isFinite(n) ? n : fallback;
}

function clamp(n, min, max) {
  return Math.min(max, Math.max(min, n));
}

/** Compact page list with ellipses (MUI-style). */
function pageItems(page, count, siblingCount, boundaryCount) {
  if (count <= 0) return [];
  page = clamp(page, 1, count);
  siblingCount = Math.max(0, siblingCount);
  boundaryCount = Math.max(0, boundaryCount);

  const show = new Set();
  for (let i = 1; i <= Math.min(boundaryCount, count); i++) show.add(i);
  for (let i = Math.max(1, count - boundaryCount + 1); i <= count; i++) show.add(i);
  for (let i = page - siblingCount; i <= page + siblingCount; i++) {
    if (i >= 1 && i <= count) show.add(i);
  }

  const sorted = [...show].sort((a, b) => a - b);
  const items = [];
  let prev = 0;
  for (const n of sorted) {
    if (prev && n - prev === 2) items.push({ type: "page", page: prev + 1 });
    else if (prev && n - prev > 2) items.push({ type: "ellipsis" });
    items.push({ type: "page", page: n });
    prev = n;
  }
  return items;
}

function iconBtn(kind, page, disabled) {
  const icons = {
    first: "chevrons-left",
    prev: "chevron-left",
    next: "chevron-right",
    last: "chevrons-right",
  };
  const labels = {
    first: "First page",
    prev: "Previous page",
    next: "Next page",
    last: "Last page",
  };
  return {
    tag: "horizontalbox",
    class: "slate-pagination-item",
    role: "button",
    "aria-label": labels[kind],
    "data-page": String(page),
    "data-kind": kind,
    disabled: disabled ? "" : undefined,
    "aria-disabled": disabled ? "true" : "false",
    tabindex: disabled ? "-1" : "0",
    valign: "center",
    halign: "center",
    children: [{ tag: "slate-icon", name: icons[kind], size: "14" }],
  };
}

function pageBtn(page, current) {
  const on = page === current;
  return {
    tag: "horizontalbox",
    class: "slate-pagination-item",
    role: "button",
    "aria-label": `Page ${page}`,
    "aria-current": on ? "page" : undefined,
    "data-page": String(page),
    "data-kind": "page",
    tabindex: on ? "0" : "0",
    valign: "center",
    halign: "center",
    children: [{ tag: "textblock", text: String(page) }],
  };
}

function ellipsisBtn() {
  return {
    tag: "horizontalbox",
    class: "slate-pagination-item slate-pagination-ellipsis",
    role: "presentation",
    "aria-hidden": "true",
    valign: "center",
    halign: "center",
    children: [{ tag: "textblock", text: "…" }],
  };
}

function paint(el) {
  const count = Math.max(0, intAttr(el, "count", 1));
  let page = clamp(intAttr(el, "page", 1), 1, Math.max(1, count || 1));
  if (count > 0 && String(el.getAttribute("page") || "") !== String(page)) {
    el.setAttribute("page", String(page));
  }

  const siblingCount = intAttr(el, "sibling-count", 1);
  const boundaryCount = intAttr(el, "boundary-count", 1);
  const showFirst = attrOn(el, "show-first");
  const showLast = attrOn(el, "show-last");
  const disabled = el.hasAttribute("disabled");

  const children = [];
  if (showFirst) {
    children.push(iconBtn("first", 1, disabled || page <= 1 || count < 1));
  }
  children.push(iconBtn("prev", Math.max(1, page - 1), disabled || page <= 1 || count < 1));

  for (const item of pageItems(page, count, siblingCount, boundaryCount)) {
    if (item.type === "ellipsis") children.push(ellipsisBtn());
    else children.push(pageBtn(item.page, page));
  }

  children.push(
    iconBtn("next", Math.min(count, page + 1), disabled || page >= count || count < 1)
  );
  if (showLast) {
    children.push(iconBtn("last", count, disabled || page >= count || count < 1));
  }

  const row = el.querySelector(".slate-pagination-row");
  if (!row) return;
  row.replaceChildren(...children.map((spec) => create(spec)).filter(Boolean));
}

function goTo(el, api, next) {
  if (el.hasAttribute("disabled")) return;
  const count = Math.max(0, intAttr(el, "count", 1));
  if (count < 1) return;
  const previous = clamp(intAttr(el, "page", 1), 1, count);
  const page = clamp(next, 1, count);
  if (page === previous) return;
  el.setAttribute("page", String(page));
  api.emit("pagechanged", { page, previous });
}

export default defineUmc({
  tag: "slate-pagination",
  attrs: {
    page: "1",
    count: "1",
    "sibling-count": "1",
    "boundary-count": "1",
    "show-first": "",
    "show-last": "",
    disabled: "",
  },

  Construct(el, api) {
    el.setAttribute("role", "navigation");
    el.setAttribute("aria-label", "Pagination");

    if (el._bound) return;
    el._bound = true;

    el.addEventListener("click", (e) => {
      const item = e.target?.closest?.(".slate-pagination-item");
      if (!item || !el.contains(item) || item.hasAttribute("disabled")) return;
      if (item.classList.contains("slate-pagination-ellipsis")) return;
      const page = Number.parseInt(item.getAttribute("data-page") || "", 10);
      if (Number.isFinite(page)) goTo(el, api, page);
    });

    el.addEventListener("keydown", (e) => {
      if (el.hasAttribute("disabled")) return;
      const count = Math.max(0, intAttr(el, "count", 1));
      const page = clamp(intAttr(el, "page", 1), 1, Math.max(1, count || 1));
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        goTo(el, api, page - 1);
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        goTo(el, api, page + 1);
      } else if (e.key === "Home") {
        e.preventDefault();
        goTo(el, api, 1);
      } else if (e.key === "End") {
        e.preventDefault();
        goTo(el, api, count);
      } else if (e.key === " " || e.key === "Enter") {
        const item = e.target?.closest?.(".slate-pagination-item");
        if (!item || !el.contains(item) || item.hasAttribute("disabled")) return;
        e.preventDefault();
        const next = Number.parseInt(item.getAttribute("data-page") || "", 10);
        if (Number.isFinite(next)) goTo(el, api, next);
      }
    });
  },

  SynchronizeProperties(el) {
    paint(el);
  },
});

--- preview ---
<verticalbox gap="14" padding="16" width="420">
  <slate-pagination count="10" page="3"></slate-pagination>
  <slate-pagination count="24" page="12" show-first show-last></slate-pagination>
</verticalbox>
