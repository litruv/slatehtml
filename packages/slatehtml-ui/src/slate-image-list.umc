    <slate-image-list-item src="https://picsum.photos/seed/q2/120/120" title="B"></slate-image-list-item>
    <slate-image-list-item src="https://picsum.photos/seed/q3/120/120" title="C"></slate-image-list-item>
    <slate-image-list-item src="https://picsum.photos/seed/q4/240/120" title="D" cols="2"></slate-image-list-item>
