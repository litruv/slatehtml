--- html ---
<scrollbox class="slate-table-scroll" width="100%" max-height="100%">
  <verticalbox class="slate-table-body" data-content width="100%" gap="0"></verticalbox>
</scrollbox>

--- style ---
self {
  display: block; /* umc-layout-ok */
  box-sizing: border-box;
  width: 100%; /* umc-layout-ok */
  --widget-padding: 0;
  --widget-radius: 8px;
  --widget-background: transparent;
  --widget-border: 1px solid var(--line, color-mix(in srgb, currentColor 16%, transparent));
  border: var(--widget-border);
  border-radius: var(--widget-radius);
  background: var(--widget-background);
  color: inherit;
  font: inherit;
  overflow: hidden; /* umc-layout-ok */
}

self[disabled] {
  opacity: 0.45;
  pointer-events: none;
}

self[selectable] slate-row:not([kind="header"]) {
  cursor: pointer;
}

self[selectable] slate-row:not([kind="header"]):hover:not([selected]) {
  --widget-background: color-mix(in srgb, currentColor 6%, transparent);
  background: var(--widget-background);
}

self:focus-visible {
  outline: 2px solid var(--accent, currentColor);
  outline-offset: 2px;
}

--- script ---
/**
 * Table shell over slate-row + slate-column.
 *
 * Markup:
 *
 *   <slate-table selectable selected="ada">
 *     <slate-row kind="header">
 *       <slate-column text="Name" width="140"></slate-column>
 *       <slate-column text="Email"></slate-column>
 *       <slate-column text="Role" width="72"></slate-column>
 *     </slate-row>
 *     <slate-row value="ada">
 *       <slate-column text="Ada"></slate-column>
 *       <slate-column text="ada@x.dev"></slate-column>
 *       <slate-column text="Admin"></slate-column>
 *     </slate-row>
 *   </slate-table>
 *
 * Header width / min-width / max-width are copied onto body cells in the same slot.
 * Flexible header columns (no width) stay fill so the rest share space.
 *
 * Shorthand:
 *   columns="Name|140, Email, Role|72"  rows="ada|Ada|a@x|Admin"
 *   (2nd pipe field that looks like a size is width; else key|Label; 3rd is width)
 *
 * Attrs: columns, rows, selected, selectable, striped, dense, disabled
 * Events: selectionchanged { value, index, cells }
 */

function looksLikeSize(value) {
  return /^\d/.test(String(value ?? "").trim());
}

function parseColumns(spec) {
  return String(spec ?? "")
    .split(/[,\n]/)
    .map((entry) => entry.trim())
    .filter(Boolean)
    .map((entry) => {
      const parts = entry.split("|").map((p) => p.trim());
      if (parts.length === 1) {
        return {
          key: parts[0].toLowerCase().replace(/\s+/g, "-"),
          label: parts[0],
          width: "",
        };
      }
      if (parts.length === 2) {
        if (looksLikeSize(parts[1])) {
          return {
            key: parts[0].toLowerCase().replace(/\s+/g, "-"),
            label: parts[0],
            width: parts[1],
          };
        }
        return { key: parts[0], label: parts[1] || parts[0], width: "" };
      }
      return {
        key: parts[0],
        label: parts[1] || parts[0],
        width: parts[2] || "",
      };
    });
}

function parseRows(spec, colCount) {
  return String(spec ?? "")
    .split(/[,\n]/)
    .map((entry) => entry.trim())
    .filter(Boolean)
    .map((entry, index) => {
      const cells = entry.split("|").map((c) => c.trim());
      if (colCount > 0 && cells.length === colCount + 1) {
        return { value: cells[0], cells: cells.slice(1) };
      }
      return { value: String(index), cells };
    });
}

function columnSpec(text, { dense = false, width = "" } = {}) {
  const spec = {
    tag: "slate-column",
    text,
    ...(dense ? { dense: "" } : {}),
  };
  if (width) spec.width = String(width);
  else spec.fill = "";
  return spec;
}

function headerRow(columns, dense) {
  return {
    tag: "slate-row",
    kind: "header",
    ...(dense ? { dense: "" } : {}),
    width: "100%",
    children: columns.map((col) => columnSpec(col.label, { dense, width: col.width })),
  };
}

function bodyRow(row, { selected, dense, stripe }) {
  const on = row.value === selected;
  return {
    tag: "slate-row",
    value: row.value,
    ...(on ? { selected: "" } : {}),
    ...(dense ? { dense: "" } : {}),
    ...(stripe ? { stripe: "" } : {}),
    width: "100%",
    children: row.cells.map((text) => columnSpec(text, { dense })),
  };
}

function slottedRows(el) {
  return [
    ...el.querySelectorAll(
      ":scope > slate-row, :scope > .slate-table-body > slate-row, :scope > .slate-table-scroll > .slate-table-body > slate-row"
    ),
  ];
}

function columnsOf(row) {
  return [...row.querySelectorAll(":scope > slate-column, :scope > .slate-row-cells > slate-column")];
}

function bodyRows(el) {
  return slottedRows(el).filter((row) => row.getAttribute("kind") !== "header");
}

function headerRowOf(el) {
  return slottedRows(el).find((row) => row.getAttribute("kind") === "header") || null;
}

function isPinnedTemplate(col) {
  if (col.hasAttribute("width")) return true;
  const minW = col.getAttribute("min-width");
  return minW != null && minW !== "" && minW !== "0" && minW !== "0px";
}

/** Copy header column sizing onto body cells in the same index. */
function applyHeaderLayout(el) {
  const header = headerRowOf(el);
  if (!header) return;
  const templates = columnsOf(header);
  if (!templates.length) return;

  for (const row of bodyRows(el)) {
    const cells = columnsOf(row);
    for (let i = 0; i < cells.length; i++) {
      const template = templates[i];
      const cell = cells[i];
      if (!template || !cell) continue;

      for (const name of ["width", "min-width", "max-width"]) {
        if (!template.hasAttribute(name)) {
          if (cell.hasAttribute("data-col-from-header")) cell.removeAttribute(name);
          continue;
        }
        const value = template.getAttribute(name);
        if (name === "min-width" && (value === "0" || value === "0px")) {
          cell.removeAttribute(name);
          continue;
        }
        cell.setAttribute(name, value);
        cell.setAttribute("data-col-from-header", "");
      }

      if (isPinnedTemplate(template)) {
        cell.removeAttribute("fill");
      } else {
        cell.setAttribute("fill", "");
        if (cell.hasAttribute("data-col-from-header") && !template.hasAttribute("width")) {
          cell.removeAttribute("width");
        }
      }
    }
  }
}

function rowCells(row) {
  return columnsOf(row).map((col) => col.getAttribute("text") || "");
}

function select(el, api, value) {
  if (el.hasAttribute("disabled") || !el.hasAttribute("selectable")) return;
  const rows = bodyRows(el);
  const index = rows.findIndex((r) => (r.getAttribute("value") || "") === value);
  if (index < 0) return;
  if (value === api.attr("selected", "")) return;
  el.setAttribute("selected", value);
  api.emit("selectionchanged", {
    value,
    index,
    cells: rowCells(rows[index]),
  });
}

export default defineUmc({
  tag: "slate-table",
  attrs: {
    columns: "",
    rows: "",
    selected: "",
    selectable: "",
    striped: "",
    dense: "",
    disabled: "",
  },

  Construct(el, api) {
    el.setAttribute("role", "table");
    if (!el.hasAttribute("tabindex")) el.setAttribute("tabindex", "0");

    if (el._tableBound) return;
    el._tableBound = true;

    el.addEventListener("clicked", (event) => {
      const row = event.target?.closest?.("slate-row");
      if (!row || !el.contains(row) || row.getAttribute("kind") === "header") return;
      if (row.hasAttribute("disabled")) return;
      const value = row.getAttribute("value") || "";
      if (value !== "") select(el, api, value);
    });

    el.addEventListener("keydown", (event) => {
      if (!el.hasAttribute("selectable") || el.hasAttribute("disabled")) return;
      const rows = bodyRows(el);
      if (!rows.length) return;
      const current = rows.findIndex((r) => (r.getAttribute("value") || "") === api.attr("selected", ""));
      if (event.key === "ArrowDown") {
        event.preventDefault();
        const next = current < 0 ? 0 : Math.min(rows.length - 1, current + 1);
        select(el, api, rows[next].getAttribute("value") || "");
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        const next = current < 0 ? rows.length - 1 : Math.max(0, current - 1);
        select(el, api, rows[next].getAttribute("value") || "");
      }
    });

    el._colLayoutObs = new MutationObserver((records) => {
      if (records.some((r) => r.target?.closest?.('slate-row[kind="header"]'))) {
        applyHeaderLayout(el);
      }
    });
    el._colLayoutObs.observe(el, {
      subtree: true,
      attributes: true,
      attributeFilter: ["width", "min-width", "max-width", "fill"],
    });
  },

  Destroyed(el) {
    el._colLayoutObs?.disconnect();
    el._colLayoutObs = null;
    el._tableBound = false;
  },

  SynchronizeProperties(el, { attr }) {
    const columns = parseColumns(attr("columns", ""));
    const parsed = parseRows(attr("rows", ""), columns.length);
    const selected = attr("selected", "");
    const dense = el.hasAttribute("dense");
    const striped = el.hasAttribute("striped");
    const fromAttrs = columns.length > 0 || parsed.length > 0;

    if (fromAttrs) {
      const key =
        columns.map((c) => `${c.key}:${c.label}:${c.width}`).join("\u0001") +
        "\u0002" +
        parsed.map((r) => `${r.value}:${r.cells.join("|")}`).join("\u0001") +
        `\u0003${selected}\u0004${dense ? 1 : 0}\u0005${striped ? 1 : 0}`;

      if (el._tableKey !== key) {
        el._tableKey = key;
        const kids = [];
        if (columns.length) kids.push(headerRow(columns, dense));
        for (let i = 0; i < parsed.length; i++) {
          const cells = [...parsed[i].cells];
          while (columns.length && cells.length < columns.length) cells.push("");
          kids.push(
            bodyRow(
              { value: parsed[i].value, cells: columns.length ? cells.slice(0, columns.length) : cells },
              { selected, dense, stripe: striped && i % 2 === 1 }
            )
          );
        }
        el.set(...kids);
      }
    } else {
      const rows = bodyRows(el);
      for (const row of slottedRows(el)) {
        row.toggleAttribute("dense", dense);
      }
      for (let i = 0; i < rows.length; i++) {
        const value = rows[i].getAttribute("value") || "";
        rows[i].toggleAttribute("selected", value === selected && selected !== "");
        rows[i].toggleAttribute("stripe", striped && i % 2 === 1);
      }
    }

    applyHeaderLayout(el);
    queueMicrotask(() => applyHeaderLayout(el));

    el.setAttribute("aria-disabled", el.hasAttribute("disabled") ? "true" : "false");
  },
});

--- preview ---
<canvaspanel width="480" height="240" kind="stage">
  <border kind="panel" padding="12" anchors="fill" top="12" left="12" right="12" bottom="12">
    <slate-table selectable striped selected="ada">
      <slate-row kind="header">
        <slate-column text="Name" width="120"></slate-column>
        <slate-column text="Email"></slate-column>
        <slate-column text="Role" width="72"></slate-column>
      </slate-row>
      <slate-row value="ada">
        <slate-column text="Ada"></slate-column>
        <slate-column text="ada@x.dev"></slate-column>
        <slate-column text="Admin"></slate-column>
      </slate-row>
      <slate-row value="linus">
        <slate-column text="Linus"></slate-column>
        <slate-column text="linus@x.dev"></slate-column>
        <slate-column text="Dev"></slate-column>
      </slate-row>
    </slate-table>
  </border>
</canvaspanel>
