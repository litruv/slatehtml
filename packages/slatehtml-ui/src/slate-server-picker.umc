--- html ---
<scrollbox class="server-list" data-content gap="6" padding="4" max-height="320"></scrollbox>

--- style ---
self {
  display: block; /* umc-layout-ok */
  box-sizing: border-box;
  color: inherit;
  font: inherit;
  min-width: 200px; /* umc-layout-ok */
}

self[disabled] {
  opacity: 0.45;
  pointer-events: none;
}

.server-list {
  box-sizing: border-box;
  background: var(--panel-deep, color-mix(in srgb, currentColor 4%, transparent));
  border: 1px solid var(--line, color-mix(in srgb, currentColor 22%, transparent));
  border-radius: var(--radius, 4px);
  --widget-padding: 6px;
}

.server-row {
  border-radius: var(--radius, 4px);
  cursor: pointer;
  user-select: none;
  -webkit-user-select: none;
}

.server-row:hover {
  background: color-mix(in srgb, var(--accent, currentColor) 12%, transparent);
}

.server-row[aria-selected="true"],
.server-row.selected {
  background: color-mix(in srgb, var(--accent, currentColor) 22%, transparent);
}

.server-row-text {
  min-width: 0; /* umc-layout-ok */
}

.server-row-label {
  font-size: 13px;
  font-weight: 600;
}

.server-row-host {
  font-size: 11px;
  opacity: 0.6;
}

.server-empty {
  padding: 10px;
  opacity: 0.6;
  font-size: 12px;
}

--- script ---
import { parseOptions, selectableOptions } from "./input/parse-options.js";
import { serverAccent, serverInitial, normalizeHost } from "./accent.js";

/**
 * Homeserver list, selectable rows with avatar images (or initials).
 *
 *   <slate-server-picker
 *     selected="matrix.org"
 *     options="matrix.org|Matrix|https://matrix.org/favicon.ico, mozilla.org|Mozilla"
 *   ></slate-server-picker>
 *
 * Options: `host`, `host|Label`, or `host|Label|imageUrl`.
 * Events: selectionchanged { value, label }, valuechanged { value }
 */

function optionRow(option, selected) {
  const value = option.value;
  const label = option.label || value;
  const host = normalizeHost(value) || value;
  const on = value === selected || host === selected;
  const avatar = (option.avatar || "").trim();
  const accent = serverAccent(value);

  const tile = {
    tag: "slate-avatar-tile",
    size: "36",
    shape: "square",
    label,
    value,
    accent,
  };
  if (avatar) tile.avatar = avatar;
  else tile.icon = serverInitial(value);

  return {
    tag: "horizontalbox",
    class: `server-row${on ? " selected" : ""}`,
    "data-value": value,
    role: "option",
    "aria-selected": on ? "true" : "false",
    gap: "10",
    valign: "center",
    padding: "8 10",
    children: [
      tile,
      {
        tag: "verticalbox",
        class: "server-row-text",
        gap: "2",
        fill: "",
        children: [
          { tag: "textblock", class: "server-row-label", text: label },
          { tag: "textblock", class: "server-row-host", text: host },
        ],
      },
    ],
  };
}

function rebuild(el) {
  const options = selectableOptions(
    parseOptions(el.getAttribute("options") || el.getAttribute("recent"))
  );
  const selected =
    el.getAttribute("selected") ||
    el.getAttribute("value") ||
    "";
  if (!options.length) {
    el.set({
      tag: "textblock",
      class: "server-empty",
      text: el.getAttribute("empty") || "No servers",
    });
    return;
  }
  el.set(...options.map((o) => optionRow(o, selected)));
}

function select(el, api, value) {
  const options = selectableOptions(
    parseOptions(el.getAttribute("options") || el.getAttribute("recent"))
  );
  const hit = options.find((o) => o.value === value);
  if (!hit) return;
  if (value === (api.attr("selected", "") || api.attr("value", ""))) return;
  el.setAttribute("selected", value);
  el.setAttribute("value", value);
  api.emit("selectionchanged", { value, label: hit.label });
  api.emit("valuechanged", { value });
}

export default defineUmc({
  tag: "slate-server-picker",
  attrs: {
    selected: "",
    value: "",
    options: "",
    recent: "",
    empty: "No servers",
    disabled: "",
  },

  Construct(el, api) {
    if (el._bound) return;
    el._bound = true;

    el.setAttribute("role", "listbox");
    if (!el.hasAttribute("tabindex")) el.setAttribute("tabindex", "0");

    el.addEventListener("click", (event) => {
      if (el.hasAttribute("disabled")) return;
      const row = event.target?.closest?.(".server-row");
      if (!row || !el.contains(row)) return;
      select(el, api, row.getAttribute("data-value") || "");
    });

    el.addEventListener("keydown", (event) => {
      if (el.hasAttribute("disabled")) return;
      const options = selectableOptions(
    parseOptions(el.getAttribute("options") || el.getAttribute("recent"))
  );
      if (!options.length) return;
      const cur = el.getAttribute("selected") || el.getAttribute("value") || "";
      const index = options.findIndex((o) => o.value === cur);
      if (event.key === "ArrowDown") {
        event.preventDefault();
        const next = index < 0 ? 0 : Math.min(options.length - 1, index + 1);
        select(el, api, options[next].value);
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        const next = index < 0 ? options.length - 1 : Math.max(0, index - 1);
        select(el, api, options[next].value);
      }
    });
  },

  SynchronizeProperties(el, { attr }) {
    if (!attr("selected", "") && attr("value", "")) {
      el.setAttribute("selected", attr("value", ""));
    }
    el.setAttribute("aria-disabled", el.hasAttribute("disabled") ? "true" : "false");
    rebuild(el);
  },
});

--- preview ---
<verticalbox gap="12" padding="16" width="320">
  <slate-server-picker
    selected="matrix.org"
    options="matrix.org|Matrix|https://matrix.org/favicon.ico, mozilla.org|Mozilla|https://www.mozilla.org/media/img/favicons/firefox/browser/favicon-196x196.59e382bdcbf50b0e89ee.png, envs.net|envs.net"
  ></slate-server-picker>
</verticalbox>
