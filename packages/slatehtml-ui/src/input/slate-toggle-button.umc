--- html ---
<textblock class="slate-toggle-label" data-umc="text"></textblock>

--- style ---
self {
  display: inline-flex; /* umc-layout-ok, painted control host */
  align-items: center; /* umc-layout-ok */
  justify-content: center; /* umc-layout-ok */
  box-sizing: border-box;
  --widget-padding: 6px 12px;
  --widget-radius: 4px;
  padding: var(--widget-padding);
  border: var(--widget-border, 1px solid currentColor);
  background: var(--widget-background, transparent);
  border-radius: var(--widget-radius);
  color: inherit;
  font: inherit;
  font-size: 12px;
  font-weight: 600;
  line-height: 1.2;
  cursor: pointer;
  user-select: none;
  -webkit-user-select: none;
  flex: 0 0 auto; /* umc-layout-ok */
}

self[pressed] {
  background: color-mix(in srgb, currentColor 18%, transparent);
}

self:hover:not([disabled]) {
  filter: brightness(1.08);
}

self:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 2px;
}

self[disabled] {
  opacity: 0.45;
  cursor: default;
  pointer-events: none;
}

self .slate-toggle-label {
  pointer-events: none;
}

--- script ---
/**
 * Toggle button, latched pressed / unpressed.
 *
 *   <slate-toggle-button text="Bold" pressed></slate-toggle-button>
 *
 * Events: changed { pressed }, clicked
 */
export default defineUmc({
  tag: "slate-toggle-button",
  attrs: {
    text: "Toggle",
    pressed: "",
    disabled: "",
  },

  events: {
    click: "clicked",
  },

  Construct(el) {
    el.setAttribute("role", "button");
    el.setAttribute("aria-pressed", el.hasAttribute("pressed") ? "true" : "false");
    if (!el.hasAttribute("tabindex")) el.setAttribute("tabindex", "0");

    if (el._keysBound) return;
    el._keysBound = true;
    el.addEventListener("keydown", (e) => {
      if (el.hasAttribute("disabled")) return;
      if (e.key === " " || e.key === "Enter") {
        e.preventDefault();
        el.click();
      }
    });
  },

  OnClicked(el, api) {
    if (el.hasAttribute("disabled")) return;
    if (el.hasAttribute("pressed")) el.removeAttribute("pressed");
    else el.setAttribute("pressed", "");
    api.emit("changed", { pressed: el.hasAttribute("pressed") });
  },

  SynchronizeProperties(el) {
    const disabled = el.hasAttribute("disabled");
    const pressed = el.hasAttribute("pressed");
    el.setAttribute("aria-pressed", pressed ? "true" : "false");
    el.setAttribute("aria-disabled", disabled ? "true" : "false");
    el.tabIndex = disabled ? -1 : 0;
  },
});

--- preview ---
<horizontalbox gap="8" padding="12">
  <slate-toggle-button text="Bold" pressed></slate-toggle-button>
  <slate-toggle-button text="Italic"></slate-toggle-button>
  <slate-toggle-button text="Off" disabled></slate-toggle-button>
</horizontalbox>
