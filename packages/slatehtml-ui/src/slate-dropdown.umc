--- html ---
<canvaspanel clip="false" class="dropdown-root" min-width="180">
  <horizontalbox class="dropdown-face" anchors="top-left top-right" valign="center" gap="8" padding="6 10">
    <slate-image class="dropdown-face-image" width="18" height="18" fit="cover" hidden></slate-image>
    <slate-icon class="dropdown-face-icon" name="" size="16" hidden></slate-icon>
    <textblock class="dropdown-label" fill></textblock>
    <textblock class="dropdown-chevron" text="▾"></textblock>
  </horizontalbox>
  <scrollbox class="dropdown-menu" data-content anchors="top-left top-right" top="0" gap="2" padding="4" max-height="220" hidden></scrollbox>
</canvaspanel>

--- style ---
self {
  color: inherit;
  font: inherit;
  line-height: 1.2;
  cursor: pointer;
  user-select: none;
  -webkit-user-select: none;
}

self[open] {
  position: relative; /* umc-layout-ok, stack above following siblings */
  z-index: 100; /* umc-layout-ok */
}

.dropdown-root {
  min-width: var(--dropdown-min-width, 180px);
}

self:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 2px;
}

self[disabled] {
  opacity: 0.45;
  cursor: default;
  pointer-events: none;
}

.dropdown-face {
  box-sizing: border-box;
  padding: var(--widget-padding, 6px 10px);
  border: var(--widget-border, 1px solid currentColor);
  background: var(--widget-background, transparent);
  border-radius: var(--widget-radius, 4px);
  z-index: 1; /* umc-layout-ok */
}

self:hover:not([disabled]) .dropdown-face {
  filter: brightness(1.08);
}

self .dropdown-label,
self .dropdown-chevron {
  pointer-events: none;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 13px;
}

self.is-placeholder .dropdown-label {
  opacity: 0.6;
}

self .dropdown-chevron {
  transition: transform 120ms ease;
}

self[open]:not([disabled]) .dropdown-chevron {
  transform: rotate(180deg);
}

self .dropdown-face-image,
self .dropdown-face-icon {
  pointer-events: none;
}

self .dropdown-face-image {
  border-radius: 3px;
  overflow: hidden;
}

self .dropdown-face-image[hidden],
self .dropdown-face-icon[hidden] {
  display: none; /* umc-layout-ok */
}

.dropdown-menu {
  box-sizing: border-box;
  max-height: var(--dropdown-max-height, 220px);
  background: var(--dropdown-background, var(--panel, #1e1f22));
  border: var(--dropdown-border, var(--widget-border, 1px solid currentColor));
  border-radius: var(--widget-radius, 4px);
  box-shadow: var(--dropdown-shadow, 0 8px 24px rgba(0, 0, 0, 0.35));
  z-index: 2; /* umc-layout-ok */
  color: inherit;
}

self .dropdown-option {
  padding: 6px 10px;
  border-radius: 3px;
  font-size: 13px;
}

self .dropdown-option:hover {
  background: color-mix(in srgb, currentColor 12%, transparent);
}

self .dropdown-option.selected {
  background: color-mix(in srgb, currentColor 20%, transparent);
}

self .dropdown-option-image {
  border-radius: 3px;
  overflow: hidden;
  pointer-events: none;
}

self .dropdown-option-icon {
  pointer-events: none;
  opacity: 0.9;
}

self .dropdown-option-label {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  pointer-events: none;
}

self .dropdown-heading {
  padding: 8px 10px 4px;
  font-size: 11px;
  font-weight: 650;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  opacity: 0.55;
  pointer-events: none;
}

self .dropdown-separator {
  height: 1px; /* umc-layout-ok */
  margin: 4px 8px;
  background: color-mix(in srgb, currentColor 18%, transparent);
  pointer-events: none;
}

self .dropdown-empty {
  padding: 6px 10px;
  opacity: 0.6;
  font-size: 12px;
}

--- script ---
import { parseOptions, selectableOptions } from "./input/parse-options.js";

/**
 * UMG-style ComboBox / dropdown.
 *
 *   <slate-dropdown options="general, random, dev" selected="random"></slate-dropdown>
 *
 * Rich menus, images, Lucide icons, headings, separators:
 *
 *   options="# Channels, text|Text|hash, voice|Voice|volume-2, ---,
 *            matrix.org|Matrix|https://matrix.org/favicon.ico"
 *
 * 3rd `|` field: `https://…` / `mxc://…` → image; otherwise Lucide kebab-case name.
 *
 * Events: selectionchanged { value, label, index }, opened / closed, clicked
 */

function mediaChildren(item, imageClass, iconClass) {
  const children = [];
  const avatar = (item.avatar || "").trim();
  const icon = (item.icon || "").trim();
  if (avatar) {
    children.push({
      tag: "slate-image",
      class: imageClass,
      src: avatar,
      width: "18",
      height: "18",
      fit: "cover",
    });
  } else if (icon) {
    children.push({
      tag: "slate-icon",
      class: iconClass,
      name: icon,
      size: "16",
    });
  }
  return children;
}

function menuRow(item) {
  if (item.type === "separator") {
    return { tag: "border", class: "dropdown-separator", role: "separator" };
  }
  if (item.type === "category") {
    return {
      tag: "textblock",
      class: "dropdown-heading",
      role: "presentation",
      text: item.label,
    };
  }

  return {
    tag: "horizontalbox",
    class: "dropdown-option",
    "data-value": item.value,
    role: "option",
    valign: "center",
    gap: "8",
    children: [
      ...mediaChildren(item, "dropdown-option-image", "dropdown-option-icon"),
      {
        tag: "textblock",
        class: "dropdown-option-label",
        fill: "",
        text: item.label,
      },
    ],
  };
}

function paintSelection(el, value) {
  for (const row of el.querySelectorAll(".dropdown-option")) {
    const on = row.getAttribute("data-value") === value;
    row.classList.toggle("selected", on);
    row.setAttribute("aria-selected", on ? "true" : "false");
  }
}

function paintFaceMedia(el, option) {
  const img = el.querySelector(".dropdown-face-image");
  const icon = el.querySelector(".dropdown-face-icon");
  const avatar = (option?.avatar || "").trim();
  const iconName = (option?.icon || "").trim();

  if (avatar && img) {
    img.setAttribute("src", avatar);
    img.removeAttribute("hidden");
    icon?.setAttribute("hidden", "");
    icon?.removeAttribute("name");
  } else if (iconName && icon) {
    icon.setAttribute("name", iconName);
    icon.removeAttribute("hidden");
    img?.removeAttribute("src");
    img?.setAttribute("hidden", "");
  } else {
    img?.removeAttribute("src");
    img?.setAttribute("hidden", "");
    icon?.removeAttribute("name");
    icon?.setAttribute("hidden", "");
  }
}

const MENU_GAP = 4;

function syncDropdownLayout(el) {
  const root = el.querySelector(".dropdown-root");
  const face = el.querySelector(".dropdown-face");
  const menu = el.querySelector(".dropdown-menu");
  if (!root || !face) return;
  const faceH = face.offsetHeight;
  if (faceH > 0) root.setAttribute("height", String(faceH));
  if (menu) menu.setAttribute("top", String(faceH + MENU_GAP));
}

function closeMenu(el, api) {
  if (!el.hasAttribute("open")) return;
  el.removeAttribute("open");
  el.querySelector(".dropdown-menu")?.setAttribute("hidden", "");
  if (el._onOutside) {
    document.removeEventListener("pointerdown", el._onOutside, true);
    el._onOutside = null;
  }
  syncDropdownLayout(el);
  api.emit("closed", { value: api.attr("selected", "") });
}

function openMenu(el, api) {
  if (el.hasAttribute("open") || el.hasAttribute("disabled")) return;
  syncDropdownLayout(el);
  el.setAttribute("open", "");
  el.querySelector(".dropdown-menu")?.removeAttribute("hidden");
  el._onOutside = (event) => {
    if (!el.contains(event.target)) closeMenu(el, api);
  };
  document.addEventListener("pointerdown", el._onOutside, true);
  api.emit("opened", { value: api.attr("selected", "") });
}

function select(el, api, value) {
  const options = selectableOptions(parseOptions(api.attr("options", "")));
  const index = options.findIndex((o) => o.value === value);
  if (index < 0 || value === api.attr("selected", "")) return;
  el.setAttribute("selected", value);
  api.emit("selectionchanged", { value, label: options[index].label, index });
}

function step(el, api, delta) {
  const options = selectableOptions(parseOptions(api.attr("options", "")));
  if (!options.length) return;
  const current = options.findIndex((o) => o.value === api.attr("selected", ""));
  const next = current < 0 ? (delta > 0 ? 0 : options.length - 1) : current + delta;
  const clamped = Math.min(options.length - 1, Math.max(0, next));
  select(el, api, options[clamped].value);
}

function itemsKey(items) {
  return items
    .map(
      (o) =>
        `${o.type}\u0000${o.value}\u0000${o.label}\u0000${o.avatar || ""}\u0000${o.icon || ""}`
    )
    .join("\u0001");
}

export default defineUmc({
  tag: "slate-dropdown",
  attrs: {
    options: "",
    selected: "",
    placeholder: "Select…",
    empty: "No options",
    open: "",
    disabled: "",
  },

  events: { click: "clicked" },

  PreConstruct(el) {
    el._optionsKey = null;
  },

  Construct(el, api) {
    el.setAttribute("role", "combobox");
    el.setAttribute("aria-haspopup", "listbox");
    el.querySelector(".dropdown-menu")?.setAttribute("role", "listbox");
    if (!el.hasAttribute("tabindex")) el.setAttribute("tabindex", "0");

    if (!el._layoutObs) {
      const face = el.querySelector(".dropdown-face");
      if (face) {
        el._layoutObs = new ResizeObserver(() => syncDropdownLayout(el));
        el._layoutObs.observe(face);
      }
    }

    if (el._keysBound) return;
    el._keysBound = true;
    el.addEventListener("keydown", (event) => {
      if (el.hasAttribute("disabled")) return;
      switch (event.key) {
        case " ":
        case "Enter":
          event.preventDefault();
          if (el.hasAttribute("open")) closeMenu(el, api);
          else openMenu(el, api);
          break;
        case "ArrowDown":
          event.preventDefault();
          step(el, api, 1);
          break;
        case "ArrowUp":
          event.preventDefault();
          step(el, api, -1);
          break;
        case "Escape":
          if (el.hasAttribute("open")) {
            event.preventDefault();
            closeMenu(el, api);
          }
          break;
        default:
          break;
      }
    });
  },

  OnClicked(el, api, event) {
    const native = event?.detail?.originalEvent ?? event;
    const target = native?.target instanceof Element ? native.target : null;
    const row = target?.closest?.(".dropdown-option");
    if (row && el.contains(row)) {
      select(el, api, row.getAttribute("data-value"));
      closeMenu(el, api);
      return;
    }
    if (el.hasAttribute("open")) closeMenu(el, api);
    else openMenu(el, api);
  },

  SynchronizeProperties(el, { attr }) {
    const items = parseOptions(attr("options", ""));
    const options = selectableOptions(items);
    const key = itemsKey(items);
    if (el._optionsKey !== key) {
      el._optionsKey = key;
      if (items.length) el.set(...items.map(menuRow));
      else el.set({ tag: "textblock", class: "dropdown-empty", text: attr("empty", "No options") });
    }

    const current = options.find((o) => o.value === attr("selected", ""));
    el.classList.toggle("is-placeholder", !current);
    el.querySelector(".dropdown-label")?.setAttribute(
      "text",
      current ? current.label : attr("placeholder", "Select…")
    );
    paintFaceMedia(el, current);
    paintSelection(el, current?.value ?? "");

    const disabled = el.hasAttribute("disabled");
    el.setAttribute("aria-expanded", el.hasAttribute("open") && !disabled ? "true" : "false");
    el.setAttribute("aria-disabled", disabled ? "true" : "false");
    el.tabIndex = disabled ? -1 : 0;
    syncDropdownLayout(el);
  },

  Destruct(el, api) {
    closeMenu(el, api);
    el._layoutObs?.disconnect();
    el._layoutObs = null;
    el._optionsKey = null;
  },
});

--- preview ---
<verticalbox gap="12" padding="16" width="320">
  <slate-dropdown
    selected="text"
    options="# Channels, text|Text|hash, voice|Voice|volume-2, ---, # Servers, matrix.org|Matrix|https://matrix.org/favicon.ico"
  ></slate-dropdown>
  <slate-dropdown options="online, idle, dnd" selected="online" disabled></slate-dropdown>
</verticalbox>
