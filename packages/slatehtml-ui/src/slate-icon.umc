--- html ---

--- style ---
self {
  display: inline-flex; /* umc-layout-ok, painted control host */
  align-items: center; /* umc-layout-ok */
  justify-content: center; /* umc-layout-ok */
  flex: 0 0 auto; /* umc-layout-ok */
  line-height: 0;
  color: inherit;
}

self > svg {
  display: block;
  width: var(--icon-size, 16px);
  height: var(--icon-size, 16px);
  stroke: currentColor;
  fill: none;
  flex: 0 0 auto; /* umc-layout-ok */
}

self[hidden] {
  display: none !important;
}

--- script ---
/**
 * Icon leaf for UMG widgets (Lucide by default).
 *
 *   <slate-icon name="chevron-down" size="16"></slate-icon>
 *   <slate-icon name="log-out" size="14" stroke-width="2"></slate-icon>
 *
 * Swap or extend the set via configure() from slatehtml-ui/configure.
 * Color follows `currentColor` / parent text color.
 */
import {
  resolveIcon,
  defaultIconSize,
  defaultIconStrokeWidth,
  onConfigure,
} from "./configure.js";

function paint(el, { attr }) {
  const name = attr("name", "");
  const size = attr("size", "") || defaultIconSize();
  const stroke = attr("stroke-width", "") || defaultIconStrokeWidth();
  el.style.setProperty("--icon-size", /^\d+$/.test(size) ? `${size}px` : size);

  const svg = resolveIcon(name, {
    width: size,
    height: size,
    "stroke-width": stroke,
    "aria-hidden": "true",
  });

  el.replaceChildren();
  if (svg) {
    el.appendChild(svg);
    el.removeAttribute("title");
  } else if (name) {
    el.setAttribute("title", `Unknown icon: ${name}`);
  }
}

export default defineUmc({
  tag: "slate-icon",
  attrs: {
    name: "",
    size: "",
    "stroke-width": "",
  },

  Construct(el, api) {
    el._slateIconOffConfigure = onConfigure(() => paint(el, api));
  },

  Destruct(el) {
    el._slateIconOffConfigure?.();
    el._slateIconOffConfigure = null;
  },

  SynchronizeProperties(el, api) {
    paint(el, api);
  },
});

--- preview ---
<horizontalbox gap="12" padding="16" valign="center">
  <slate-icon name="search" size="18"></slate-icon>
  <textblock kind="hint" text="slate-icon · any Lucide name → lucide.dev/icons"></textblock>
</horizontalbox>
