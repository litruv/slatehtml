--- html ---
<horizontalbox class="slate-list-item-row" gap="10" valign="center" width="100%">
  <slate-icon class="slate-list-item-icon" name="" size="18" hidden></slate-icon>
  <verticalbox class="slate-list-item-copy" gap="2" fill min-width="0">
    <textblock class="slate-list-item-label" data-umc="text"></textblock>
    <textblock class="slate-list-item-secondary" data-umc="secondary" hidden></textblock>
  </verticalbox>
  <textblock class="slate-list-item-meta" data-umc="meta" hidden></textblock>
</horizontalbox>

--- style ---
self {
  display: block; /* umc-layout-ok */
  box-sizing: border-box;
  width: 100%; /* umc-layout-ok */
  --widget-padding: 8px 12px;
  --widget-radius: 6px;
  --widget-background: transparent;
  --widget-border: none;
  padding: var(--widget-padding);
  border-radius: var(--widget-radius);
  background: var(--widget-background);
  color: inherit;
  font: inherit;
  font-size: 13px;
  cursor: pointer;
  user-select: none;
  -webkit-user-select: none;
}

self:hover:not([disabled]):not([selected]) {
  --widget-background: color-mix(in srgb, currentColor 8%, transparent);
  background: var(--widget-background);
}

self[selected] {
  --widget-background: color-mix(in srgb, var(--accent, currentColor) 16%, transparent);
  background: var(--widget-background);
}

self[selected]:hover:not([disabled]) {
  --widget-background: color-mix(in srgb, var(--accent, currentColor) 22%, transparent);
  background: var(--widget-background);
}

self[disabled] {
  opacity: 0.45;
  pointer-events: none;
  cursor: default;
}

self:focus-visible {
  outline: 2px solid var(--accent, currentColor);
  outline-offset: -2px;
}

.slate-list-item-label {
  font-weight: 550;
  line-height: 1.25;
  min-width: 0; /* umc-layout-ok */
}

.slate-list-item-secondary {
  font-size: 12px;
  line-height: 1.3;
  color: var(--muted, inherit);
  opacity: 0.85;
}

.slate-list-item-meta {
  font-size: 11px;
  color: var(--muted, inherit);
  flex: 0 0 auto; /* umc-layout-ok */
}

.slate-list-item-icon[hidden],
.slate-list-item-secondary[hidden],
.slate-list-item-meta[hidden] {
  display: none !important;
}

self[dense] {
  --widget-padding: 4px 10px;
  font-size: 12px;
}

--- script ---
/**
 * One row in a slate-list.
 *
 *   <slate-list-item value="inbox" text="Inbox" icon="inbox"></slate-list-item>
 *   <slate-list-item text="Ada" secondary="Admin" meta="2h" selected></slate-list-item>
 *
 * Attrs: value, text, secondary, meta, icon, selected, disabled, dense
 * Events: clicked { value, text }
 */
export default defineUmc({
  tag: "slate-list-item",
  attrs: {
    value: "",
    text: "",
    secondary: "",
    meta: "",
    icon: "",
    selected: "",
    disabled: "",
    dense: "",
  },

  events: {
    click: "clicked",
  },

  Construct(el) {
    el.setAttribute("role", "option");
    if (!el.hasAttribute("tabindex")) el.setAttribute("tabindex", "-1");
  },

  SynchronizeProperties(el, { attr, bind }) {
    bind();
    const iconName = (attr("icon", "") || "").trim();
    const icon = el.querySelector(".slate-list-item-icon");
    if (icon) {
      icon.toggleAttribute("hidden", !iconName);
      if (iconName) icon.setAttribute("name", iconName);
    }
    const secondary = (attr("secondary", "") || "").trim();
    el.querySelector(".slate-list-item-secondary")?.toggleAttribute("hidden", !secondary);
    const meta = (attr("meta", "") || "").trim();
    el.querySelector(".slate-list-item-meta")?.toggleAttribute("hidden", !meta);

    const selected = el.hasAttribute("selected");
    el.setAttribute("aria-selected", selected ? "true" : "false");
    el.setAttribute("aria-disabled", el.hasAttribute("disabled") ? "true" : "false");
    el.tabIndex = selected ? 0 : -1;
  },
});

--- preview ---
<verticalbox gap="4" padding="12" width="280">
  <slate-list-item text="Inbox" icon="inbox" selected></slate-list-item>
  <slate-list-item text="Ada Lovelace" secondary="Administrator" meta="2h" icon="user"></slate-list-item>
</verticalbox>
