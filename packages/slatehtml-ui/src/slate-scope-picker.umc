--- html ---
<canvaspanel clip="false" class="scope-picker-root" width="100%" min-width="0">
  <scrollbox class="scope-picker-menu" data-content anchors="top-left top-right" top="0" gap="2" padding="4" max-height="220" hidden></scrollbox>
  <horizontalbox class="scope-picker-face" anchors="fill" valign="center" gap="8" padding="6 10">
    <slate-avatar-tile class="scope-picker-face-tile"></slate-avatar-tile>
    <textblock class="scope-picker-label" fill></textblock>
    <textblock class="scope-picker-chevron" text="▾"></textblock>
  </horizontalbox>
</canvaspanel>

--- style ---
/* Own the flex/sizebox slot (same as slate-server-picker) so the canvas has a box. */
self {
  display: block;
  box-sizing: border-box;
  color: inherit;
  font: inherit;
  line-height: 1.2;
}

.scope-picker-root {
  width: 100%;
  height: 100%;
}

.scope-picker-face {
  box-sizing: border-box;
  padding: var(--widget-padding, 6px 10px);
  border: var(--widget-border, 1px solid currentColor);
  background: var(--widget-background, transparent);
  border-radius: var(--widget-radius, 4px);
  z-index: 1; /* umc-layout-ok — face above canvas menu layer */
  cursor: pointer;
  user-select: none;
  -webkit-user-select: none;
}

self:focus-visible .scope-picker-face {
  outline: 2px solid currentColor;
  outline-offset: 2px;
}

self[disabled] {
  opacity: 0.45;
  pointer-events: none;
}

self[disabled] .scope-picker-face {
  cursor: default;
}

self:hover:not([disabled]) .scope-picker-face {
  filter: brightness(1.08);
}

.scope-picker-label,
.scope-picker-chevron {
  pointer-events: none;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

self.is-placeholder .scope-picker-label {
  opacity: 0.6;
}

.scope-picker-chevron {
  color: var(--ink-muted, #949ba4);
  transition: transform 120ms ease;
}

self[open]:not([disabled]) .scope-picker-chevron {
  transform: rotate(180deg);
}

self[open] .scope-picker-root {
  position: relative; /* umc-layout-ok — open menu stacking */
  z-index: 100; /* umc-layout-ok */
}

self[flush] .scope-picker-face {
  border-radius: 0;
  --widget-border: none;
  border-bottom: 1px solid var(--scope-picker-divider, var(--line, #1f2023));
}

.scope-picker-menu {
  box-sizing: border-box;
  z-index: 100; /* umc-layout-ok */
  max-height: var(--scope-picker-max-height, 220px);
  background: var(--scope-picker-background, var(--widget-background, #2b2d31));
  border: var(--scope-picker-border, var(--widget-border, 1px solid currentColor));
  border-radius: var(--widget-radius, 4px);
  box-shadow: var(--scope-picker-shadow, 0 8px 24px rgba(0, 0, 0, 0.35));
}

.scope-picker-empty {
  padding: 8px 10px;
  opacity: 0.6;
  font-size: 12px;
}

--- script ---
/**
 * Scope filter dropdown with square space avatars (mxc) and flip-up menu.
 *
 * Options: `value|label` or `value|label|mxc://…` (from formatScopeOptions).
 * Menu rows are `<scope-picker-option>` components.
 *
 * Events: selectionchanged { value, label, index }, opened, closed, clicked
 */

function parseOptionEntry(entry) {
  const parts = entry.split("|");
  if (parts.length < 2) {
    const value = entry.trim();
    return { value, label: value };
  }
  const avatarPart = parts[parts.length - 1].trim();
  const hasAvatar = /^(mxc:|https?:)/i.test(avatarPart);
  if (hasAvatar && parts.length >= 3) {
    const value = parts[0].trim();
    const label = parts.slice(1, -1).join("|").trim() || value;
    return { value, label, avatar: avatarPart };
  }
  const value = parts[0].trim();
  const label = parts.slice(1).join("|").trim() || value;
  return { value, label };
}

function parseOptions(spec) {
  return String(spec ?? "")
    .split(/[,\n]/)
    .map((entry) => entry.trim())
    .filter(Boolean)
    .map(parseOptionEntry);
}

function optionKey(option) {
  return `${option.value}\u0000${option.label}\u0000${option.avatar || ""}`;
}

function optionSpec(option, selectedValue) {
  const spec = {
    tag: "scope-picker-option",
    value: option.value,
    label: option.label,
  };
  if (option.avatar) spec.avatar = option.avatar;
  if (option.value === selectedValue) spec.selected = "";
  return spec;
}

function paintFace(el, option) {
  const tile = el.querySelector(".scope-picker-face-tile");
  if (!tile) return;
  const value = option?.value ?? "dms";
  const label = option?.label ?? "";
  const avatar = option?.avatar ?? "";
  tile.setAttribute("value", value);
  tile.setAttribute("label", label);
  if (avatar) tile.setAttribute("avatar", avatar);
  else tile.removeAttribute("avatar");
  if (el.hasAttribute("flush")) {
    tile.setAttribute("shape", "square");
    tile.setAttribute("size", "32");
  }
}

function syncOptionSelection(el, selected) {
  for (const row of el.querySelectorAll("scope-picker-option")) {
    const on = row.getAttribute("value") === selected;
    row.toggleAttribute("selected", on);
  }
}

const MENU_GAP = 4;

function resolvePlacement(el, menu) {
  const mode = el.getAttribute("placement") || "auto";
  if (mode === "bottom") return "bottom";
  if (mode === "top") return "top";
  const anchor = el.querySelector(".scope-picker-face") ?? el;
  const rect = anchor.getBoundingClientRect();
  const maxH = Number(menu?.getAttribute("max-height")) || 220;
  const below = window.innerHeight - rect.bottom;
  const above = rect.top;
  return below < maxH && above > below ? "top" : "bottom";
}

function scopeBarHeight(el, root, face) {
  const explicit = Number.parseFloat(el.getAttribute("height") || root.getAttribute("height") || "");
  if (Number.isFinite(explicit) && explicit > 0) return Math.round(explicit);
  if (root.clientHeight > 0) return root.clientHeight;
  const faceH = face.offsetHeight;
  return faceH > 0 ? faceH : 0;
}

function syncScopeLayout(el) {
  const root = el.querySelector(".scope-picker-root");
  const face = el.querySelector(".scope-picker-face");
  const menu = el.querySelector(".scope-picker-menu");
  if (!root || !face) return;

  const flush = el.hasAttribute("flush");
  const faceH = scopeBarHeight(el, root, face);

  // Canvas absolute children don't contribute height — always size the root.
  if (faceH > 0) root.setAttribute("height", String(faceH));

  const pinFaceFill = () => {
    face.setAttribute("anchors", "fill");
    face.removeAttribute("top");
    face.removeAttribute("bottom");
  };

  const pinFaceTop = () => {
    face.setAttribute("anchors", "top-left top-right");
    face.setAttribute("top", "0");
    face.removeAttribute("bottom");
  };

  if (!menu || !el.hasAttribute("open")) {
    menu?.setAttribute("hidden", "");
    menu?.style.removeProperty("top");
    if (flush) pinFaceFill();
    else pinFaceTop();
    return;
  }

  menu.removeAttribute("hidden");
  const placement = resolvePlacement(el, menu);
  const maxH = Number(menu.getAttribute("max-height")) || 220;
  const menuH = Math.min(menu.scrollHeight || maxH, maxH);

  if (placement === "top") {
    menu.setAttribute("anchors", "top-left top-right");
    menu.setAttribute("top", String(-(menuH + MENU_GAP)));
  } else {
    menu.setAttribute("anchors", "top-left top-right");
    menu.setAttribute("top", String(faceH + MENU_GAP));
  }

  if (flush) pinFaceFill();
  else pinFaceTop();
}

function closeMenu(el, api) {
  if (!el.hasAttribute("open")) return;
  el.removeAttribute("open");
  if (el._onOutside) {
    document.removeEventListener("pointerdown", el._onOutside, true);
    el._onOutside = null;
  }
  syncScopeLayout(el);
  api.emit("closed", { value: api.attr("selected", "") });
}

function openMenu(el, api) {
  if (el.hasAttribute("open") || el.hasAttribute("disabled")) return;
  syncScopeLayout(el);
  el.setAttribute("open", "");
  syncScopeLayout(el);
  requestAnimationFrame(() => syncScopeLayout(el));
  el._onOutside = (event) => {
    if (!el.contains(event.target)) closeMenu(el, api);
  };
  document.addEventListener("pointerdown", el._onOutside, true);
  api.emit("opened", { value: api.attr("selected", "") });
}

function select(el, api, value) {
  const options = parseOptions(api.attr("options", ""));
  const index = options.findIndex((o) => o.value === value);
  if (index < 0 || value === api.attr("selected", "")) return;
  el.setAttribute("selected", value);
  api.emit("selectionchanged", {
    value,
    label: options[index].label,
    index,
  });
}

function step(el, api, delta) {
  const options = parseOptions(api.attr("options", ""));
  if (!options.length) return;
  const current = options.findIndex((o) => o.value === api.attr("selected", ""));
  const next = current < 0 ? (delta > 0 ? 0 : options.length - 1) : current + delta;
  const clamped = Math.min(options.length - 1, Math.max(0, next));
  select(el, api, options[clamped].value);
}

export default defineUmc({
  tag: "slate-scope-picker",
  attrs: {
    options: "",
    selected: "",
    placeholder: "Select…",
    empty: "No options",
    placement: "auto",
    open: "",
    disabled: "",
    flush: "",
    "face-padding": "6 10",
  },

  events: { click: "clicked" },

  PreConstruct(el) {
    el._optionsKey = null;
  },

  Construct(el, api) {
    el.setAttribute("role", "combobox");
    el.setAttribute("aria-haspopup", "listbox");
    el.querySelector(".scope-picker-menu")?.setAttribute("role", "listbox");
    if (!el.hasAttribute("tabindex")) el.setAttribute("tabindex", "0");

    const face = el.querySelector(".scope-picker-face");
    const root = el.querySelector(".scope-picker-root");
    if (face && root && !el._layoutObs) {
      el._layoutObs = new ResizeObserver(() => syncScopeLayout(el));
      el._layoutObs.observe(face);
      el._layoutObs.observe(root);
    }

    if (el._keysBound) return;
    el._keysBound = true;
    el.addEventListener("keydown", (event) => {
      if (el.hasAttribute("disabled")) return;
      switch (event.key) {
        case " ":
        case "Enter":
          event.preventDefault();
          if (el.hasAttribute("open")) closeMenu(el, api);
          else openMenu(el, api);
          break;
        case "ArrowDown":
          event.preventDefault();
          step(el, api, 1);
          break;
        case "ArrowUp":
          event.preventDefault();
          step(el, api, -1);
          break;
        case "Escape":
          if (el.hasAttribute("open")) {
            event.preventDefault();
            closeMenu(el, api);
          }
          break;
        default:
          break;
      }
    });
  },

  OnClicked(el, api, event) {
    const native = event?.detail?.originalEvent ?? event;
    const target = native?.target instanceof Element ? native.target : null;
    const row = target?.closest?.("scope-picker-option");
    if (row && el.contains(row)) {
      select(el, api, row.getAttribute("value"));
      closeMenu(el, api);
      return;
    }
    if (el.hasAttribute("open")) closeMenu(el, api);
    else openMenu(el, api);
  },

  SynchronizeProperties(el, { attr }) {
    const options = parseOptions(attr("options", ""));
    const selected = attr("selected", "");

    const key = options.map(optionKey).join("\u0001");
    if (el._optionsKey !== key) {
      el._optionsKey = key;
      if (options.length) {
        el.set(...options.map((o) => optionSpec(o, selected)));
      } else {
        el.set({
          tag: "textblock",
          class: "scope-picker-empty",
          text: attr("empty", "No options"),
        });
      }
    } else {
      syncOptionSelection(el, selected);
    }

    const current = options.find((o) => o.value === selected);
    el.classList.toggle("is-placeholder", !current);
    el.querySelector(".scope-picker-label")?.setAttribute(
      "text",
      current ? current.label : attr("placeholder", "Select…")
    );
    paintFace(el, current ?? { value: "dms", label: "" });

    const face = el.querySelector(".scope-picker-face");
    const facePadding = attr("face-padding", "6 10");
    if (facePadding) face?.setAttribute("padding", facePadding);
    else face?.removeAttribute("padding");

    const root = el.querySelector(".scope-picker-root");
    if (root) {
      for (const name of [
        "width",
        "height",
        "min-width",
        "max-width",
        "min-height",
        "max-height",
        "fill",
      ]) {
        if (el.hasAttribute(name)) root.setAttribute(name, el.getAttribute(name));
        else root.removeAttribute(name);
      }
    }

    const disabled = el.hasAttribute("disabled");
    el.setAttribute("aria-expanded", el.hasAttribute("open") && !disabled ? "true" : "false");
    el.setAttribute("aria-disabled", disabled ? "true" : "false");
    el.tabIndex = disabled ? -1 : 0;
    syncScopeLayout(el);
  },

  Destruct(el, api) {
    closeMenu(el, api);
    el._layoutObs?.disconnect();
    el._layoutObs = null;
    el._optionsKey = null;
  },
});

--- preview ---
<verticalbox gap="12" padding="16" width="280">
  <slate-scope-picker
    fill
    options="dms|Direct messages, rooms|Rooms, !preview:matrix.org|Preview Space|https://matrix.org/favicon.ico"
    selected="dms"
    placement="auto"
  ></slate-scope-picker>
  <textblock kind="hint" text="Menu rows are scope-picker-option components"></textblock>
</verticalbox>
