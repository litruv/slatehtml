--- html ---
<canvaspanel clip="false" class="combobox-root">
  <horizontalbox class="combobox-face" anchors="top-left top-right" valign="center" gap="6" padding="0">
    <editabletext class="combobox-input" fill min-height="40"></editabletext>
    <slate-icon class="combobox-toggle" name="chevron-down" size="16"></slate-icon>
  </horizontalbox>
  <scrollbox class="combobox-menu" data-content anchors="top-left top-right" top="0" gap="2" padding="4" max-height="220" hidden></scrollbox>
</canvaspanel>

--- style ---
/* Own the flex slot when `fill` is set (host opts out of display:contents). */
self {
  display: block;
  box-sizing: border-box;
  color: inherit;
  font: inherit;
}

self[disabled] {
  opacity: 0.45;
  pointer-events: none;
}

.combobox-face {
  box-sizing: border-box;
  --widget-background: var(--bg-input, #383a40);
  --widget-border: none;
  --widget-radius: 4px;
  --widget-padding: 0 4px 0 0;
  background: var(--widget-background);
  border-radius: var(--widget-radius);
}

.combobox-face:focus-within {
  outline: 2px solid var(--blurple, #5865f2);
  outline-offset: 0;
}

.combobox-input {
  --widget-background: transparent;
  --widget-border: none;
  --widget-radius: 4px;
  --widget-padding: 10px 12px;
  color: var(--ink, #f2f3f5);
  font-size: 14px;
}

.combobox-input:focus {
  outline: none;
}

.combobox-toggle {
  color: var(--ink-muted, #949ba4);
  padding: 8px 10px;
  cursor: pointer;
  border-radius: 4px;
  transition: transform 120ms ease;
}

.combobox-toggle:focus-visible {
  outline: none;
}

self[open]:not([disabled]) .combobox-toggle {
  transform: rotate(180deg);
}

.combobox-menu {
  box-sizing: border-box;
  max-height: var(--combobox-max-height, 220px);
  background: var(--bg-channels, #2b2d31);
  border: 1px solid var(--line, #1f2023);
  border-radius: 4px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  color: var(--ink, #f2f3f5);
}

.combobox-heading {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--ink-muted, #949ba4);
  padding: 8px 10px 4px;
}

.combobox-option {
  padding: 8px 10px;
  border-radius: 3px;
  font-size: 13px;
  cursor: pointer;
}

.combobox-option:hover {
  background: color-mix(in srgb, currentColor 12%, transparent);
}

.combobox-option.selected {
  background: color-mix(in srgb, var(--blurple, #5865f2) 28%, transparent);
}

.combobox-empty {
  padding: 8px 10px;
  opacity: 0.6;
  font-size: 12px;
}

--- script ---
/**
 * Editable combobox: free text + optional dropdown of recent / suggested values.
 *
 *   <slate-combobox value="matrix.org" options="matrix.org,mozilla.org"></slate-combobox>
 *   <slate-combobox options="a|Alpha, b|Beta" recent="b,c" recent-label="Recent"></slate-combobox>
 *
 * Options use the same grammar as slate-dropdown (`a,b` or `value|Label` / `value:Label`).
 * `recent` is the same grammar; those entries appear first (deduped from `options`).
 *
 * Events: valuechanged { value }, selectionchanged { value, label }, opened / closed
 */

/** Same grammar as slate-dropdown. Prefer `|` when values may contain `:`. */
function parseOptions(spec) {
  return String(spec ?? "")
    .split(/[,\n]/)
    .map((entry) => entry.trim())
    .filter(Boolean)
    .map((entry) => {
      const pipe = entry.indexOf("|");
      if (pipe >= 0) {
        const value = entry.slice(0, pipe).trim();
        const label = entry.slice(pipe + 1).trim();
        return { value, label: label || value };
      }
      const split = entry.indexOf(":");
      if (split < 0) return { value: entry, label: entry };
      const value = entry.slice(0, split).trim();
      const label = entry.slice(split + 1).trim();
      return { value, label: label || value };
    });
}

function inputEl(el) {
  return el.querySelector(".combobox-input");
}

function readValue(el) {
  const input = inputEl(el);
  return (input?.getAttribute("text") ?? input?.textContent ?? "").trim();
}

function writeValue(el, value) {
  const next = String(value ?? "");
  const input = inputEl(el);
  input?.setAttribute("text", next);
  el.setAttribute("value", next);
}

const MENU_GAP = 4;

function syncComboboxLayout(el) {
  const root = el.querySelector(".combobox-root");
  const face = el.querySelector(".combobox-face");
  const menu = el.querySelector(".combobox-menu");
  if (!root || !face) return;
  const faceH = face.offsetHeight;
  if (faceH > 0) root.setAttribute("height", String(faceH));
  if (menu) menu.setAttribute("top", String(faceH + MENU_GAP));
}

function closeMenu(el, api) {
  if (!el.hasAttribute("open")) return;
  el.removeAttribute("open");
  el.querySelector(".combobox-menu")?.setAttribute("hidden", "");
  if (el._onOutside) {
    document.removeEventListener("pointerdown", el._onOutside, true);
    el._onOutside = null;
  }
  syncComboboxLayout(el);
  api.emit("closed", { value: readValue(el) });
}

function openMenu(el, api) {
  if (el.hasAttribute("open") || el.hasAttribute("disabled")) return;
  rebuildMenu(el);
  syncComboboxLayout(el);
  el.setAttribute("open", "");
  el.querySelector(".combobox-menu")?.removeAttribute("hidden");
  el._onOutside = (event) => {
    if (!el.contains(event.target)) closeMenu(el, api);
  };
  document.addEventListener("pointerdown", el._onOutside, true);
  api.emit("opened", { value: readValue(el) });
}

function menuSections(el) {
  const recent = parseOptions(el.getAttribute("recent"));
  const options = parseOptions(el.getAttribute("options"));
  const recentValues = new Set(recent.map((o) => o.value));
  const suggested = options.filter((o) => !recentValues.has(o.value));
  const sections = [];
  if (recent.length) {
    sections.push({
      title: el.getAttribute("recent-label") || "Recent",
      items: recent,
    });
  }
  if (suggested.length) {
    sections.push({
      title:
        recent.length > 0
          ? el.getAttribute("options-label") || "Suggested"
          : null,
      items: suggested,
    });
  }
  return sections;
}

function rebuildMenu(el) {
  const current = readValue(el);
  const sections = menuSections(el);
  const rows = [];
  for (const section of sections) {
    if (section.title) {
      rows.push({
        tag: "textblock",
        class: "combobox-heading",
        text: section.title,
      });
    }
    for (const item of section.items) {
      rows.push({
        tag: "textblock",
        class: `combobox-option${item.value === current ? " selected" : ""}`,
        "data-value": item.value,
        role: "option",
        text: item.label,
      });
    }
  }
  if (!rows.length) {
    el.set({
      tag: "textblock",
      class: "combobox-empty",
      text: el.getAttribute("empty") || "No options",
    });
  } else {
    el.set(...rows);
  }
}

function pick(el, api, value) {
  const sections = menuSections(el);
  let label = value;
  for (const section of sections) {
    const hit = section.items.find((o) => o.value === value);
    if (hit) {
      label = hit.label;
      break;
    }
  }
  writeValue(el, value);
  api.emit("selectionchanged", { value, label });
  api.emit("valuechanged", { value });
  closeMenu(el, api);
  inputEl(el)?.focus?.();
}

export default defineUmc({
  tag: "slate-combobox",
  attrs: {
    value: "",
    options: "",
    recent: "",
    "recent-label": "Recent",
    "options-label": "Suggested",
    empty: "No options",
    open: "",
    disabled: "",
  },

  Construct(el, api) {
    if (el._bound) return;
    el._bound = true;

    el.setAttribute("role", "combobox");
    el.setAttribute("aria-haspopup", "listbox");
    el.querySelector(".combobox-menu")?.setAttribute("role", "listbox");

    const face = el.querySelector(".combobox-face");
    if (face && !el._layoutObs) {
      el._layoutObs = new ResizeObserver(() => syncComboboxLayout(el));
      el._layoutObs.observe(face);
    }

    const input = inputEl(el);
    input?.addEventListener("focus", () => {
      // Defer so programmatic focus (e.g. login open) still selects.
      requestAnimationFrame(() => {
        if (document.activeElement !== input) return;
        const range = document.createRange();
        range.selectNodeContents(input);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
      });
    });
    input?.addEventListener("textchanged", () => {
      const value = readValue(el);
      el.setAttribute("value", value);
      api.emit("valuechanged", { value });
    });
    input?.addEventListener("committed", () => {
      closeMenu(el, api);
    });

    el.addEventListener("click", (event) => {
      const toggle = event.target?.closest?.(".combobox-toggle");
      if (toggle && el.contains(toggle)) {
        event.preventDefault();
        if (el.hasAttribute("open")) closeMenu(el, api);
        else openMenu(el, api);
        return;
      }
      const row = event.target?.closest?.(".combobox-option");
      if (row && el.contains(row)) {
        event.preventDefault();
        pick(el, api, row.getAttribute("data-value") || "");
      }
    });

    el.addEventListener("keydown", (event) => {
      if (el.hasAttribute("disabled")) return;
      if (event.key === "Escape" && el.hasAttribute("open")) {
        event.preventDefault();
        event.stopPropagation();
        closeMenu(el, api);
        return;
      }
      if (event.key === "ArrowDown" && !el.hasAttribute("open")) {
        event.preventDefault();
        openMenu(el, api);
      }
    });

    /** Rebuild the menu from current `options` / `recent` attrs (e.g. after persist). */
    el.refresh = () => {
      if (el.hasAttribute("open")) rebuildMenu(el);
    };
  },

  Destroyed(el, api) {
    closeMenu(el, api);
    el._layoutObs?.disconnect();
    el._layoutObs = null;
    el._bound = false;
  },

  SynchronizeProperties(el, { attr }) {
    const value = attr("value", "");
    const input = inputEl(el);
    if (input && input.getAttribute("text") !== value) {
      input.setAttribute("text", value);
    }
    const isOpen = el.hasAttribute("open");
    el.setAttribute("aria-expanded", isOpen ? "true" : "false");
    el.setAttribute(
      "aria-disabled",
      el.hasAttribute("disabled") ? "true" : "false"
    );
    if (!isOpen && el._onOutside) {
      document.removeEventListener("pointerdown", el._onOutside, true);
      el._onOutside = null;
    }
    if (isOpen) rebuildMenu(el);
    syncComboboxLayout(el);
  },
});

--- preview ---
<verticalbox gap="12" padding="16" width="360">
  <slate-combobox
    value="matrix.org"
    options="matrix.org,mozilla.org,envs.net"
    recent="matrix.org"
  ></slate-combobox>
  <textblock kind="hint" text="Type freely, or open ▾ for recent / suggested."></textblock>
</verticalbox>
