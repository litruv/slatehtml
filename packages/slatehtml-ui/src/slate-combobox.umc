--- html ---
<canvaspanel clip="false" class="combobox-root">
  <horizontalbox class="combobox-face" anchors="top-left top-right" valign="center" gap="6" padding="0">
    <editabletext class="combobox-input" fill min-height="36"></editabletext>
    <textblock class="combobox-chevron" text="▾"></textblock>
  </horizontalbox>
  <scrollbox class="combobox-menu" data-content anchors="top-left top-right" top="0" gap="2" padding="4" max-height="220" hidden></scrollbox>
</canvaspanel>

--- style ---
self {
  display: block; /* umc-layout-ok */
  box-sizing: border-box;
  color: inherit;
  font: inherit;
  min-width: 180px; /* umc-layout-ok */
}

self[disabled] {
  opacity: 0.45;
  pointer-events: none;
}

self[open] {
  position: relative; /* umc-layout-ok */
  z-index: 100; /* umc-layout-ok */
}

.combobox-face {
  box-sizing: border-box;
  --widget-background: var(--bg-input, color-mix(in srgb, currentColor 6%, transparent));
  --widget-border: 1px solid var(--line, color-mix(in srgb, currentColor 35%, transparent));
  --widget-radius: var(--radius, 4px);
  --widget-padding: 0 8px 0 0;
  background: var(--widget-background);
  border: var(--widget-border);
  border-radius: var(--widget-radius);
  z-index: 1; /* umc-layout-ok */
}

.combobox-face:focus-within {
  outline: 2px solid var(--accent, currentColor);
  outline-offset: 0;
}

.combobox-input {
  --widget-background: transparent;
  --widget-border: none;
  --widget-radius: 4px;
  --widget-padding: 8px 10px;
  font-size: 13px;
  color: inherit;
}

.combobox-input:focus {
  outline: none;
}

.combobox-chevron {
  opacity: 0.55;
  font-size: 12px;
  cursor: pointer;
  padding: 6px;
  transition: transform 120ms ease;
}

self[open]:not([disabled]) .combobox-chevron {
  transform: rotate(180deg);
}

.combobox-menu {
  box-sizing: border-box;
  max-height: var(--combobox-max-height, 220px);
  background: var(--panel, #f3f7f4);
  border: 1px solid var(--line, color-mix(in srgb, currentColor 35%, transparent));
  border-radius: var(--radius, 4px);
  box-shadow: 0 8px 24px color-mix(in srgb, #000 28%, transparent);
  z-index: 2; /* umc-layout-ok */
  color: inherit;
}

.combobox-heading {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  opacity: 0.55;
  padding: 8px 10px 4px;
}

.combobox-option {
  padding: 6px 10px;
  border-radius: 3px;
  font-size: 13px;
  cursor: pointer;
}

.combobox-option:hover,
.combobox-option.selected {
  background: color-mix(in srgb, var(--accent, currentColor) 18%, transparent);
}

.combobox-empty {
  padding: 6px 10px;
  opacity: 0.6;
  font-size: 12px;
}

--- script ---
import fuzzysort from "fuzzysort";
import { parseOptions, selectableOptions } from "./input/parse-options.js";

/**
 * Editable combobox, free text + fuzzysort-filtered suggestions (recent + options).
 *
 *   <slate-combobox value="matrix.org" options="matrix.org,mozilla.org"></slate-combobox>
 *   <slate-combobox options="a|Alpha, b|Beta" recent="b" recent-label="Recent"></slate-combobox>
 *
 * Typing filters the open menu. Chevron toggles the full list.
 * Events: valuechanged { value }, selectionchanged { value, label }, opened / closed
 */

function inputEl(el) {
  return el.querySelector(".combobox-input");
}

function readValue(el) {
  const input = inputEl(el);
  return (input?.getAttribute("text") ?? input?.textContent ?? "").trim();
}

function writeValue(el, value) {
  const next = String(value ?? "");
  inputEl(el)?.setAttribute("text", next);
  el.setAttribute("value", next);
}

const MENU_GAP = 4;

function syncLayout(el) {
  const root = el.querySelector(".combobox-root");
  const face = el.querySelector(".combobox-face");
  const menu = el.querySelector(".combobox-menu");
  if (!root || !face) return;
  const faceH = face.offsetHeight;
  if (faceH > 0) root.setAttribute("height", String(faceH));
  if (menu) menu.setAttribute("top", String(faceH + MENU_GAP));
}

function closeMenu(el, api) {
  if (!el.hasAttribute("open")) return;
  el.removeAttribute("open");
  el.querySelector(".combobox-menu")?.setAttribute("hidden", "");
  if (el._onOutside) {
    document.removeEventListener("pointerdown", el._onOutside, true);
    el._onOutside = null;
  }
  syncLayout(el);
  api.emit("closed", { value: readValue(el) });
}

function openMenu(el, api) {
  if (el.hasAttribute("disabled")) return;
  rebuildMenu(el);
  syncLayout(el);
  if (!el.hasAttribute("open")) {
    el.setAttribute("open", "");
    el.querySelector(".combobox-menu")?.removeAttribute("hidden");
    el._onOutside = (event) => {
      if (!el.contains(event.target)) closeMenu(el, api);
    };
    document.addEventListener("pointerdown", el._onOutside, true);
    api.emit("opened", { value: readValue(el) });
  } else {
    el.querySelector(".combobox-menu")?.removeAttribute("hidden");
  }
}

function allItems(el) {
  const recent = selectableOptions(parseOptions(el.getAttribute("recent")));
  const options = selectableOptions(parseOptions(el.getAttribute("options")));
  const recentValues = new Set(recent.map((o) => o.value));
  return {
    recent,
    suggested: options.filter((o) => !recentValues.has(o.value)),
  };
}

function filterItems(items, query) {
  if (!query) return items;
  const hits = fuzzysort.go(query, items, {
    keys: ["label", "value"],
    threshold: -50000,
    limit: 50,
  });
  return hits.map((hit) => hit.obj);
}

function rebuildMenu(el) {
  const current = readValue(el);
  const { recent, suggested } = allItems(el);
  const q = current;
  const recentHits = filterItems(recent, q);
  const suggestedHits = filterItems(suggested, q);
  const rows = [];

  if (recentHits.length) {
    rows.push({
      tag: "textblock",
      class: "combobox-heading",
      text: el.getAttribute("recent-label") || "Recent",
    });
    for (const item of recentHits) {
      rows.push({
        tag: "textblock",
        class: `combobox-option${item.value === current ? " selected" : ""}`,
        "data-value": item.value,
        role: "option",
        text: item.label,
      });
    }
  }

  if (suggestedHits.length) {
    if (recentHits.length || (!q && recent.length)) {
      rows.push({
        tag: "textblock",
        class: "combobox-heading",
        text: el.getAttribute("options-label") || "Suggested",
      });
    }
    for (const item of suggestedHits) {
      rows.push({
        tag: "textblock",
        class: `combobox-option${item.value === current ? " selected" : ""}`,
        "data-value": item.value,
        role: "option",
        text: item.label,
      });
    }
  }

  if (!rows.length) {
    el.set({
      tag: "textblock",
      class: "combobox-empty",
      text: el.getAttribute("empty") || "No matches",
    });
  } else {
    el.set(...rows);
  }
}

function pick(el, api, value) {
  const { recent, suggested } = allItems(el);
  const hit = [...recent, ...suggested].find((o) => o.value === value);
  const label = hit?.label || value;
  writeValue(el, value);
  api.emit("selectionchanged", { value, label });
  api.emit("valuechanged", { value });
  closeMenu(el, api);
  inputEl(el)?.focus?.();
}

export default defineUmc({
  tag: "slate-combobox",
  attrs: {
    value: "",
    options: "",
    recent: "",
    "recent-label": "Recent",
    "options-label": "Suggested",
    empty: "No matches",
    open: "",
    disabled: "",
  },

  Construct(el, api) {
    if (el._bound) return;
    el._bound = true;

    el.setAttribute("role", "combobox");
    el.setAttribute("aria-haspopup", "listbox");
    el.setAttribute("aria-autocomplete", "list");
    el.querySelector(".combobox-menu")?.setAttribute("role", "listbox");

    const face = el.querySelector(".combobox-face");
    if (face && !el._layoutObs) {
      el._layoutObs = new ResizeObserver(() => syncLayout(el));
      el._layoutObs.observe(face);
    }

    const input = inputEl(el);
    input?.addEventListener("focus", () => {
      openMenu(el, api);
      requestAnimationFrame(() => {
        if (document.activeElement !== input) return;
        const range = document.createRange();
        range.selectNodeContents(input);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
      });
    });
    input?.addEventListener("textchanged", () => {
      const value = readValue(el);
      el.setAttribute("value", value);
      api.emit("valuechanged", { value });
      openMenu(el, api);
      rebuildMenu(el);
    });
    input?.addEventListener("committed", () => closeMenu(el, api));

    el.addEventListener("click", (event) => {
      const chevron = event.target?.closest?.(".combobox-chevron");
      if (chevron && el.contains(chevron)) {
        event.preventDefault();
        if (el.hasAttribute("open")) closeMenu(el, api);
        else openMenu(el, api);
        return;
      }
      const row = event.target?.closest?.(".combobox-option");
      if (row && el.contains(row)) {
        event.preventDefault();
        pick(el, api, row.getAttribute("data-value") || "");
      }
    });

    el.addEventListener("keydown", (event) => {
      if (el.hasAttribute("disabled")) return;
      if (event.key === "Escape" && el.hasAttribute("open")) {
        event.preventDefault();
        event.stopPropagation();
        closeMenu(el, api);
        return;
      }
      if (event.key === "ArrowDown") {
        event.preventDefault();
        openMenu(el, api);
      }
    });

    el.refresh = () => {
      if (el.hasAttribute("open")) rebuildMenu(el);
    };
  },

  Destroyed(el, api) {
    closeMenu(el, api);
    el._layoutObs?.disconnect();
    el._layoutObs = null;
    el._bound = false;
  },

  SynchronizeProperties(el, { attr }) {
    const value = attr("value", "");
    const input = inputEl(el);
    if (input && input !== document.activeElement && input.getAttribute("text") !== value) {
      input.setAttribute("text", value);
    }
    el.setAttribute("aria-expanded", el.hasAttribute("open") ? "true" : "false");
    el.setAttribute("aria-disabled", el.hasAttribute("disabled") ? "true" : "false");
    if (!el.hasAttribute("open") && el._onOutside) {
      document.removeEventListener("pointerdown", el._onOutside, true);
      el._onOutside = null;
    }
    if (el.hasAttribute("open")) rebuildMenu(el);
    syncLayout(el);
  },
});

--- preview ---
<verticalbox gap="12" padding="16" width="320">
  <slate-combobox
    value=""
    options="matrix.org,mozilla.org,envs.net,synapse.example"
    recent="matrix.org"
  ></slate-combobox>
  <textblock kind="hint" text="Type to filter, fuzzysort ranks recent + suggested."></textblock>
</verticalbox>
